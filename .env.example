# =====================================================================
# Share&Care (ShareServe) Environment Configuration Example
# =====================================================================
# IMPORTANT:
# - Do NOT commit `.env` or any production secrets to version control.
# - Copy this file to `.env.local` or `.env` and fill in your values.
# =====================================================================

# Application Metadata
VITE_APP_NAME="Share&Care"
VITE_APP_ENV="development"
VITE_APP_URL="http://localhost:5173"

# Backend API Configuration (Optional: when transitioning from LocalStorage to live server)
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_API_TIMEOUT_MS=15000

# Supabase Realtime / Cloud Database Configuration (Optional)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key-here"

# Map Provider API Keys (Optional: when enabling external GPS/tile layers)
VITE_MAPBOX_ACCESS_TOKEN="pk.your_mapbox_public_token_here"
VITE_GOOGLE_MAPS_API_KEY=""

# SMS / WhatsApp Notification Gateway (For volunteer dispatch updates)
VITE_SMS_GATEWAY_URL=""

# Storage Bucket (For uploaded donation photos & NGO certificates)
VITE_STORAGE_BUCKET_NAME="sharecare-uploads"
